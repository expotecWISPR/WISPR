# ─────────────────────────────────────────────
# BASE DE DATOS (Supabase PostgreSQL)
# Obtenerla en: Supabase → Settings → Database → Connection string → URI
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:[TU-PASSWORD]@[TU-HOST].supabase.co:5432/postgres

# ─────────────────────────────────────────────
# AUTENTICACIÓN JWT
# Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
# ─────────────────────────────────────────────
SECRET_KEY=cambia_esto_por_una_clave_aleatoria_larga

# ─────────────────────────────────────────────
# CORREO (verificación MFA) — opcional.
# Sin SMTP_HOST, el código de verificación se registra en el log del
# servidor y en backend/data/outbox/ en vez de enviarse ("modo
# desarrollo") — útil para probar sin credenciales reales. Para enviarlo
# de verdad con Gmail: activa verificación en 2 pasos en la cuenta que
# va a enviar, y creá una "contraseña de aplicación" en
# https://myaccount.google.com/apppasswords (NO es tu contraseña normal).
# Nunca pongas esa contraseña acá en .env.example — solo en tu .env real
# (está en .gitignore, nunca se sube).
# ─────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ─────────────────────────────────────────────
# SESIONES Y CÓDIGOS MFA — opcional, estos son los valores por defecto.
# ─────────────────────────────────────────────
# SESSION_IDLE_HOURS=12
# SESSION_MAX_DAYS=7
# OTP_TTL_MINUTES=10
# OTP_RESEND_COOLDOWN_SECONDS=30
# OTP_MAX_ATTEMPTS=5
# LOGIN_LOCK_THRESHOLD=5
# LOGIN_LOCK_WINDOW_MINUTES=15
# LOGIN_LOCK_DURATION_MINUTES=15

# ─────────────────────────────────────────────
# TOGETHER AI (LLM)
# Obtener en: api.together.ai → Settings → API Keys
# ─────────────────────────────────────────────
TOGETHER_API_KEY=tu_api_key_de_together_ai
# Opcional: modelo que escribe las historias (por defecto meta-models/Muse-Glimmer-30B)
# TOGETHER_MODEL=meta-models/Muse-Glimmer-30B

# ─────────────────────────────────────────────
# AWS (S3 + CloudWatch)
# Obtener en: AWS Console → IAM → Users → Security credentials
# ─────────────────────────────────────────────
AWS_ACCESS_KEY_ID=tu_access_key_id
AWS_SECRET_ACCESS_KEY=tu_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=wispr-challenges

# ─────────────────────────────────────────────
# ENTORNO
# ─────────────────────────────────────────────
ENVIRONMENT=development
# Orígenes permitidos por CORS (coma). "*" en desarrollo; en producción el
# dominio real del frontend, ej. https://wispr.ejemplo.com
CORS_ORIGINS=*
